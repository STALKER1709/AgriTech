# ==============================================================================
# AgriTech — configuration locale
# Copiez ce fichier en `.env` puis lancez `php artisan key:generate`.
# Aucune valeur sensible ne doit être commitée dans git.
# ==============================================================================

APP_NAME=AgriTech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Contexte camerounais : interface en français, heure de Douala.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Douala

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Base de données (Laragon / XAMPP : utilisateur `root` sans mot de passe)
# Créez au préalable les deux bases :
#   CREATE DATABASE agritech CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE agritech_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agritech
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# File d'attente en base : `php artisan queue:work` (obligatoire pour les
# callbacks de la passerelle de paiement simulée).
QUEUE_CONNECTION=database

CACHE_STORE=database

# ------------------------------------------------------------------------------
# E-mails : `log` écrit dans storage/logs/laravel.log (aucun service externe).
# Avec Mailpit installé localement, basculez MAIL_MAILER sur `smtp`.
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@agritech.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Passerelle de paiement SIMULÉE (aucun opérateur réel n'est contacté).
#   PAYMENT_GATEWAY                  : implémentation active (`fake` en local)
#   PAYMENT_WEBHOOK_SECRET           : clé HMAC signant les callbacks simulés
#   PAYMENT_CALLBACK_DELAY_SECONDS   : latence imitée avant le callback
#   PAYMENT_EXPIRATION_MINUTES       : délai au-delà duquel un paiement expire
#   ORDER_CANCEL_AFTER_MINUTES       : annulation des commandes non payées
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY=fake
PAYMENT_WEBHOOK_SECRET=changez-cette-cle-en-local
PAYMENT_CALLBACK_DELAY_SECONDS=5
PAYMENT_EXPIRATION_MINUTES=15
ORDER_CANCEL_AFTER_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
